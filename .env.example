# Massive market data API (validation/reference provider; consolidated feed)
MASSIVE_API_KEY=

# Alpaca Market Data API -- the canonical 1-minute market-data source (SIP
# feed; free Basic plan keys work for historical SIP). Feed is chosen
# explicitly in config/data_sources.yaml (providers.alpaca.feed, default
# "sip"); the "iex" feed is single-exchange data, NOT consolidated.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# FRED (Federal Reserve Economic Data)
FRED_API_KEY=

# BLS (Bureau of Labor Statistics) - optional, public API allows unauthenticated
# low-volume use, but a registration key raises rate limits.
BLS_API_KEY=
